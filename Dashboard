<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SyncD — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Space+Mono:wght@400&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#07070f;--surface:#0d0d1c;--surface2:#111120;
  --border:#1a1a32;--border2:#222238;
  --accent:#3df5a8;--accent2:#ff3c6e;
  --text:#ddddf0;--muted:#4a4a6a;--muted2:#333355;
  --discord:#5865F2;--tiktok:#fe2c55;--youtube:#FF0000;--x:#e7e9ea;
}
html,body{height:100%;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-weight:300;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:999;opacity:0.3;}

/* AUTH GATE — shown while checking auth */
#gate{
  position:fixed;inset:0;z-index:500;
  background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:20px;
  transition:opacity 0.4s ease;
}
#gate.hidden{opacity:0;pointer-events:none;}
.gate-logo{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:4px;color:var(--accent);}
.gate-logo span{color:var(--muted);}
.gate-spinner{width:20px;height:20px;border:1.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}

/* LAYOUT */
.shell{display:flex;height:100vh;overflow:hidden;}

/* SIDEBAR */
.sidebar{
  width:220px;flex-shrink:0;
  background:var(--surface);
  border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  padding:0;overflow:hidden;
}
.sidebar-logo{
  padding:20px 24px;
  border-bottom:1px solid var(--border);
  font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:4px;
  color:var(--accent);flex-shrink:0;
  display:flex;align-items:center;justify-content:space-between;
}
.sidebar-logo span{color:var(--muted);}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.3;}}

.sidebar-section{padding:20px 16px 8px;font-family:'Space Mono',monospace;font-size:8px;letter-spacing:2px;color:var(--muted2);text-transform:uppercase;}

.nav-item{
  display:flex;align-items:center;gap:12px;
  padding:10px 16px;margin:1px 8px;
  border-radius:4px;
  font-size:13px;color:var(--muted);
  cursor:pointer;transition:background 0.15s,color 0.15s;
  position:relative;
}
.nav-item:hover{background:rgba(255,255,255,0.03);color:var(--text);}
.nav-item.active{background:rgba(61,245,168,0.07);color:var(--accent);}
.nav-item.active::before{content:'';position:absolute;left:0;top:4px;bottom:4px;width:2px;background:var(--accent);border-radius:0 2px 2px 0;}
.nav-icon{width:16px;height:16px;opacity:0.6;flex-shrink:0;}
.nav-item.active .nav-icon{opacity:1;}
.nav-badge{margin-left:auto;background:var(--accent2);color:#fff;font-family:'Space Mono',monospace;font-size:8px;padding:2px 6px;border-radius:10px;font-weight:700;}

.platform-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 16px;margin:1px 8px;
  border-radius:4px;cursor:pointer;
  font-size:12px;color:var(--muted);
  transition:background 0.15s,color 0.15s;
}
.platform-item:hover{background:rgba(255,255,255,0.03);color:var(--text);}
.pdot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}

.sidebar-bottom{
  margin-top:auto;border-top:1px solid var(--border);padding:16px;
}
.user-row{display:flex;align-items:center;gap:10px;}
.user-avatar{width:30px;height:30px;border-radius:50%;border:1px solid var(--border);object-fit:cover;background:var(--muted2);flex-shrink:0;}
.user-avatar-placeholder{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--discord));display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:14px;color:var(--bg);flex-shrink:0;}
.user-info{flex:1;min-width:0;}
.user-name{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.user-email{font-family:'Space Mono',monospace;font-size:9px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sign-out{
  font-family:'Space Mono',monospace;font-size:9px;letter-spacing:1px;
  color:var(--muted);cursor:pointer;padding:4px;
  transition:color 0.2s;flex-shrink:0;
  background:none;border:none;text-transform:uppercase;
}
.sign-out:hover{color:var(--accent2);}

/* MAIN */
.main{flex:1;overflow-y:auto;display:flex;flex-direction:column;}

/* TOP BAR */
.topbar{
  position:sticky;top:0;z-index:10;
  background:rgba(7,7,15,0.9);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:0 32px;height:56px;
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;
}
.topbar-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;}
.topbar-right{display:flex;align-items:center;gap:16px;}
.topbar-tag{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;}
.connect-btn{
  font-family:'Space Mono',monospace;font-size:9px;letter-spacing:1.5px;text-transform:uppercase;
  padding:8px 16px;background:var(--accent);color:var(--bg);
  border:none;cursor:pointer;font-weight:700;transition:opacity 0.2s;
}
.connect-btn:hover{opacity:0.85;}

/* CONTENT */
.content{padding:32px;flex:1;}

/* STATS ROW */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px;}
.stat-card{
  background:var(--surface);border:1px solid var(--border);
  padding:20px 20px 18px;
  transition:border-color 0.2s;cursor:default;
}
.stat-card:hover{border-color:var(--border2);}
.stat-platform{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:36px;line-height:1;margin-bottom:4px;}
.stat-label{font-size:11px;color:var(--muted);}
.stat-delta{font-family:'Space Mono',monospace;font-size:9px;margin-top:6px;}
.up{color:var(--accent);}
.dn{color:var(--accent2);}

/* CONNECT BANNER */
.connect-banner{
  background:var(--surface);border:1px solid var(--border);
  padding:32px;margin-bottom:28px;
  display:flex;align-items:center;justify-content:space-between;
  gap:24px;
}
.banner-left{}
.banner-title{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:1px;margin-bottom:6px;}
.banner-sub{font-size:13px;color:var(--muted);}
.banner-platforms{display:flex;gap:8px;margin-top:16px;}
.banner-plat{
  display:flex;align-items:center;gap:6px;
  padding:7px 12px;border:1px solid var(--border);
  font-family:'Space Mono',monospace;font-size:8px;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--muted);cursor:pointer;
  transition:border-color 0.2s,color 0.2s;
}
.banner-plat:hover{color:var(--text);}
.banner-plat.connected{color:var(--accent);border-color:rgba(61,245,168,0.3);}
.banner-plat .check{color:var(--accent);font-size:10px;}

/* GRID */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px;}
.card{background:var(--surface);border:1px solid var(--border);padding:0;}
.card-head{
  padding:14px 20px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.card-title{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1px;}
.card-tag{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);}
.card-body{padding:16px 20px;}

/* Feed items */
.feed-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
.feed-item:last-child{border-bottom:none;}
.feed-avatar{width:28px;height:28px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:12px;color:#fff;}
.feed-content{flex:1;min-width:0;}
.feed-user{font-size:12px;font-weight:500;margin-bottom:2px;}
.feed-text{font-size:12px;color:var(--muted);line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.feed-meta{display:flex;align-items:center;gap:8px;margin-top:4px;}
.feed-time{font-family:'Space Mono',monospace;font-size:9px;color:var(--muted2);}
.feed-plat{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:1px;text-transform:uppercase;padding:1px 6px;border-radius:2px;}

/* Analytics placeholder */
.chart-placeholder{
  height:140px;display:flex;align-items:flex-end;gap:4px;padding:16px 20px;
}
.bar{flex:1;border-radius:2px 2px 0 0;opacity:0.7;transition:opacity 0.2s;}
.bar:hover{opacity:1;}

/* Empty state */
.empty-state{
  padding:48px 20px;text-align:center;
  display:flex;flex-direction:column;align-items:center;gap:12px;
}
.empty-icon{font-size:32px;opacity:0.3;}
.empty-title{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;color:var(--muted);}
.empty-sub{font-size:12px;color:var(--muted2);}

/* Responsive */
@media(max-width:900px){
  .sidebar{width:60px;}
  .sidebar-logo{font-size:0;padding:20px 0;justify-content:center;}
  .sidebar-logo::after{content:'S';font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:0;color:var(--accent);}
  .nav-item span,.platform-item span,.sidebar-section,.user-info,.sidebar-logo span{display:none;}
  .nav-item{justify-content:center;padding:12px 0;margin:2px 4px;}
  .sidebar-bottom{padding:12px 4px;}
  .user-row{justify-content:center;}
  .stats-row{grid-template-columns:repeat(2,1fr);}
  .grid-2{grid-template-columns:1fr;}
}
</style>
</head>
