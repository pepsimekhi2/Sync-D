<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.0/firebase-app.js";
import { getAuth, onAuthStateChanged, signOut as fbSignOut }
  from "https://www.gstatic.com/firebasejs/11.0.0/firebase-auth.js";

const app  = initializeApp({
  apiKey:"AIzaSyAHyxMA24gj5MScTqwIQT_mr1fBXRNejfE",
  authDomain:"sync-d-d2662.firebaseapp.com",
  projectId:"sync-d-d2662",
  storageBucket:"sync-d-d2662.firebasestorage.app",
  messagingSenderId:"675444032052",
  appId:"1:675444032052:web:8849dd365eef86c1818061"
});
const auth = getAuth(app);

onAuthStateChanged(auth, user => {
  const gate  = document.getElementById('gate');
  const shell = document.getElementById('shell');
  if (!user) {
    window.location.href = 'signin.html';
    return;
  }
  // Populate user info
  const name  = user.displayName || 'User';
  const email = user.email || '';
  const photo = user.photoURL;
  document.getElementById('sidebarName').textContent  = name;
  document.getElementById('sidebarEmail').textContent = email;
  if (photo) {
    document.getElementById('avatarImg').src = photo;
    document.getElementById('avatarImg').style.display = 'block';
    document.getElementById('avatarPlaceholder').style.display = 'none';
  } else {
    document.getElementById('avatarPlaceholder').textContent = name[0].toUpperCase();
  }
  // Greeting
  const h = new Date().getHours();
  const greet = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
  document.getElementById('greetTag').textContent = greet + ', ' + name.split(' ')[0];
  // Reveal
  gate.classList.add('hidden');
  setTimeout(() => { gate.style.display = 'none'; shell.style.opacity = '1'; }, 400);
});

window.signOut = async function() {
  await fbSignOut(auth);
  window.location.href = 'signin.html';
};

window.setPage = function(page) {
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  event.currentTarget.classList.add('active');
  const titles = {overview:'Overview',feed:'Live Feed',analytics:'Analytics',schedule:'Schedule'};
  document.getElementById('pageTitle').textContent = titles[page] || page;
};

// Draw placeholder bars
const chart = document.getElementById('chartArea');
